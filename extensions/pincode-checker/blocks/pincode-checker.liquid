{%- comment -%} naya: customer ka desh, Shopify Markets se {%- endcomment -%}
{%- assign pdc_country = localization.country.iso_code | default: 'IN' -%}

{%- comment -%} naya: merchant ne placeholder khaali chhoda ho to desh ke hisaab se {%- endcomment -%}
{%- if block.settings.placeholder != blank -%}
  {%- assign pdc_placeholder = block.settings.placeholder -%}
{%- elsif pdc_country == 'IN' -%}
  {%- assign pdc_placeholder = 'Enter pincode' -%}
{%- elsif pdc_country == 'US' -%}
  {%- assign pdc_placeholder = 'Enter ZIP code' -%}
{%- else -%}
  {%- assign pdc_placeholder = 'Enter postcode' -%}
{%- endif -%}

<div class="pdc" data-pincode-checker data-country="{{ pdc_country }}">
  {% if block.settings.heading != blank %}
    <p class="pdc__heading">{{ block.settings.heading }}</p>
  {% endif %}

  <form class="pdc__form" novalidate>
    <input
      class="pdc__input"
      type="text"
      {% if pdc_country == 'IN' or pdc_country == 'US' %}inputmode="numeric"{% endif %}
      maxlength="10"
      autocomplete="postal-code"
      placeholder="{{ pdc_placeholder }}"
      aria-label="{{ pdc_placeholder }}"
    >
    <button
      class="pdc__button"
      type="submit"
      style="background: {{ block.settings.button_color }};"
    >
      {{ block.settings.button_text }}
    </button>
  </form>

  <div class="pdc__result" aria-live="polite"></div>
</div>

{% schema %}
{
  "name": "Pincode checker",
  "target": "section",
  "javascript": "pincode-checker.js",
  "stylesheet": "pincode-checker.css",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check delivery" },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "info": "Leave empty to show Pincode / ZIP code / Postcode automatically by country"
    },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Check" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#000000" }
  ]
}
{% endschema %}