<div class="pdc" data-pincode-checker>
  {% if block.settings.heading != blank %}
    <p class="pdc__heading">{{ block.settings.heading }}</p>
  {% endif %}

  <form class="pdc__form" novalidate>
    <input
      class="pdc__input"
      type="text"
      inputmode="numeric"
      maxlength="6"
      autocomplete="postal-code"
      placeholder="{{ block.settings.placeholder }}"
      aria-label="{{ block.settings.placeholder }}"
    >
    <button
      class="pdc__button"
      type="submit"
      style="background: {{ block.settings.button_color }};"
    >
      {{ block.settings.button_text }}
    </button>
  </form>

  <div class="pdc__result" aria-live="polite"></div>
</div>

{% schema %}
{
  "name": "Pincode checker",
  "target": "section",
  "javascript": "pincode-checker.js",
  "stylesheet": "pincode-checker.css",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check delivery" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter pincode" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Check" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#000000" }
  ]
}
{% endschema %}